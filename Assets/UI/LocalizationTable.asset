    - "\u0411\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430 \u043A\u0430\u0440\u0442\u0438\u043D
      \u043D\u0430 \u044D\u0442\u043E\u043C \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0435
      \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F: {0} \u0440\u0430\u0431\u043E\u0442/\u043A\u0430\u0440\u0442\u0438\u043D
      \u0431\u0443\u0434\u0443\u0442 \u043F\u0435\u0440\u0435\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u044B."
    - "La biblioteca de cuadros de este dispositivo es diferente: {0} obras/cuadros
